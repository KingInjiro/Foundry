{
  "name": "@foundry/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.js",
    "dev:local": "node --experimental-strip-types scripts/start-local.mjs",
    "local:reset": "node scripts/reset-local.mjs",
    "build": "node scripts/clean-output.mjs && vite build && esbuild server.js --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && node scripts/write-server-profile.mjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node scripts/clean-output.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/clean-e2e.mjs && playwright test",
    "test:e2e:single-host": "node scripts/run-single-host-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:smoke": "node scripts/smoke-production.mjs",
    "test:staging": "node scripts/smoke-staging.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:firebase-config": "node scripts/verify-firebase-config.mjs",
    "verify:staging:firebase": "node scripts/verify-firebase-staging.mjs",
    "verify:staging:r2": "node scripts/verify-r2-staging.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:rehearse": "node scripts/db-rehearsal.mjs",
    "single-host:backup": "node scripts/single-host-backup.mjs",
    "single-host:restore": "node scripts/single-host-restore.mjs",
    "single-host:rehearse": "node scripts/single-host-rehearsal.mjs",
    "single-host:user": "node scripts/local-user.mjs",
    "single-host:doctor": "node scripts/single-host-doctor.mjs",
    "admin:provision": "node scripts/provision-admin.mjs",
    "storage:check": "node scripts/check-storage-integrity.mjs",
    "fixture:streaming": "node make-zip.cjs",
    "verify": "node ../../scripts/verify-imports.mjs ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@foundry/engine": "0.1.0",
    "@foundry/player": "0.1.0",
    "monaco-editor": "^0.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@xyflow/react": "^12.11.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "10.9.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "mime-types": "^3.0.2",
    "mobile-drag-drop": "^3.0.0-rc.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "ws": "^8.21.2",
    "vite": "^6.2.3",
    "@foundry/contracts": "0.1.0",
    "@monaco-editor/react": "^4.7.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/express": "^4.17.21",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "assemblyscript": "^0.28.20",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10",
    "cannon-es": "^0.20.0",
    "matter-js": "^0.20.0",
    "poly-decomp": "^0.3.0",
    "three": "^0.185.1"
  },
  "files": [
    "src",
    "public",
    "e2e",
    "tests",
    "scripts",
    "docs",
    "make-zip.cjs",
    "README.md",
    "index.html",
    "sandbox.html",
    "generic-sandbox.html",
    "server.js",
    "vite.config.js",
    "tsconfig.json",
    "playwright.config.js",
    "firebase-applet-config.json",
    ".env.example"
  ]
}
