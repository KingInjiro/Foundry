# Foundry staging/production profile
# Copy to .env only in the deployment secret/config system. Never commit .env.
# Select exactly one profile: cloud or single-host. Production requires this explicitly.
FOUNDRY_DEPLOYMENT_MODE=cloud
# Optional object-storage selector. Empty retains cloud=r2 / single-host=local-disk.
FOUNDRY_STORAGE_PROVIDER=

# Core
NODE_ENV=production
PLATFORM_PUBLIC_BASE_URL=https://staging.example.com
PORT=3000
# cloud: bind only to the private interface expected by the host.
# single-host: this must be 127.0.0.1/::1/localhost behind the same-server proxy.
HOST=0.0.0.0
# Optional absolute override; by default runtime verifies dist/client/deployment-profile.json.
PLATFORM_CLIENT_BUILD_PROFILE=

# Cloud-only Firebase client (public build-time identifiers; keep environments separate)
# Single-host builds leave all VITE_FIREBASE_* values empty.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Cloud-only Firebase Admin
FIREBASE_PROJECT_ID=
# Operational verifier/deployment target for the checked-in Firestore rules.
# Current editor persistence uses the Platform API + SQLite, not Firestore.
FIRESTORE_DATABASE_ID=ai-studio-foundryengine-2c0d9198-817d-437d-8b2b-d5a59c60420c
# Use one deliberate credential mode: an absolute mounted service-account path,
# or workload identity/application-default credentials with the explicit flag.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false

# Cloud, or optional single-host FOUNDRY_STORAGE_PROVIDER=r2. Server only.
# See docs/SINGLE_HOST_R2_ACCEPTANCE.md before enabling on an existing installation.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Required for single-host R2: stable, unique installation component (not a path).
R2_OBJECT_PREFIX=
R2_UPLOAD_URL_TTL_SECONDS=900
# Must remain false in production so moderation can revoke every asset read.
R2_DIRECT_DOWNLOADS=false
R2_DOWNLOAD_URL_TTL_SECONDS=120

# SQLite — absolute path on a persistent volume is required in both profiles
PLATFORM_DB_PATH=/var/lib/foundry/platform.db

# Single-host-only persistent root and local security settings.
# Create <FOUNDRY_DATA_DIR>/objects, objects/.tmp, and backups before startup.
# Generate both secrets independently (for example: openssl rand -hex 48).
FOUNDRY_DATA_DIR=
LOCAL_AUTH_SESSION_SECRET=
LOCAL_AUTH_SESSION_TTL_SECONDS=604800
# Optional single-host Google sign-in, SERVER ONLY. Both must be valid to enable.
# Callback: PLATFORM_PUBLIC_BASE_URL + /api/auth/google/callback
# Configure proxy log redaction first; see docs/GOOGLE_AUTH_RUNBOOK.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LOCAL_STORAGE_SIGNING_SECRET=
LOCAL_STORAGE_UPLOAD_URL_TTL_SECONDS=900
# Keep false unless the DB is deliberately mounted outside FOUNDRY_DATA_DIR.
SINGLE_HOST_ALLOW_EXTERNAL_DB_PATH=false

# Jobs
JOB_MODE=async
JOB_WORKER_ID=foundry-staging-1
JOB_LEASE_MS=60000
MAX_JOB_ATTEMPTS=3
MAX_PUBLISH_ATTEMPTS=3
UPLOAD_CLEANUP_INTERVAL_MS=900000
UPLOAD_SESSION_EXPIRATION_MS=86400000
COMPLETED_UPLOAD_RETENTION_MS=604800000

# Security
# Same-origin API needs no CORS entry. Add only explicit HTTPS origins.
CORS_ALLOWED_ORIGINS=
# Set this to the exact number of trusted reverse-proxy hops. Zero is safest.
TRUST_PROXY_HOPS=0
# Enable only when the public endpoint is guaranteed HTTPS.
ENABLE_HSTS=false
E2E_MODE=false
SINGLE_HOST_TEST_MODE=false
LOCAL_DEV_MODE=false
AUTH_DEV_BYPASS=false
ALLOW_UNREADY_STARTUP=false
SHUTDOWN_GRACE_MS=30000

# Observability
LOG_LEVEL=info

# Limits
PLATFORM_MAX_STORAGE_BYTES_PER_USER=1073741824
PLATFORM_MAX_ACTIVE_UPLOADS_PER_USER=10
PLATFORM_MAX_GAME_VERSIONS_PER_USER=100
PLATFORM_MAX_PACKAGE_SIZE_BYTES=52428800
PLATFORM_MAX_FILES_PER_PACKAGE=1000
PLATFORM_MAX_EXTRACTED_FILES_PER_PACKAGE=1000
PLATFORM_MAX_TOTAL_EXTRACTED_SIZE_BYTES=104857600
PLATFORM_MAX_FILE_SIZE_BYTES=20971520
