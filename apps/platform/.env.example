# Cloudflare R2 Credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Optional: after the Platform verifies that a version is still published,
# redirect non-document assets to a short-lived signed R2 URL. HTML/SVG remain
# behind the Platform proxy so its sandbox headers cannot be bypassed.
R2_DIRECT_DOWNLOADS=false
R2_DOWNLOAD_URL_TTL_SECONDS=120

# Optional server configuration
PORT=3000
HOST=127.0.0.1
# Explicit path for the current single-node SQLite deployment profile.
PLATFORM_DB_PATH=.data/platform.db
# Production refuses to listen if database or storage readiness fails.
# Keep false; true is intended only for controlled diagnostics.
ALLOW_UNREADY_STARTUP=false
# Comma-separated trusted origins for cross-origin account/metadata API clients.
# Public /api/cdn assets keep their own wildcard CORS policy.
CORS_ALLOWED_ORIGINS=
# Expired package ZIPs are checked every 15 minutes (minimum: 60000 ms).
UPLOAD_CLEANUP_INTERVAL_MS=900000
# Incomplete uploads expire after 24 hours; completed source ZIPs remain
# publishable/retryable for 7 days before cleanup.
UPLOAD_SESSION_EXPIRATION_MS=86400000
COMPLETED_UPLOAD_RETENTION_MS=604800000

# Optional per-developer and per-package limits (defaults shown).
PLATFORM_MAX_STORAGE_BYTES_PER_USER=1073741824
PLATFORM_MAX_ACTIVE_UPLOADS_PER_USER=10
PLATFORM_MAX_GAME_VERSIONS_PER_USER=100
PLATFORM_MAX_PACKAGE_SIZE_BYTES=52428800
PLATFORM_MAX_FILES_PER_PACKAGE=1000
PLATFORM_MAX_EXTRACTED_FILES_PER_PACKAGE=1000
PLATFORM_MAX_TOTAL_EXTRACTED_SIZE_BYTES=104857600
PLATFORM_MAX_FILE_SIZE_BYTES=20971520
MAX_PUBLISH_ATTEMPTS=3
# Durable job claims are recovered after an abandoned worker lease expires.
JOB_LEASE_MS=60000
# debug | info | warn | error; server logs are newline-delimited JSON.
LOG_LEVEL=info
