{
  "name": "foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @foundry/platform",
    "dev:local": "npm run dev:local -w @foundry/platform",
    "local:reset": "npm run local:reset -w @foundry/platform",
    "build": "npm run build -w @foundry/platform",
    "test": "npm run test -w @foundry/contracts && npm run test -w @foundry/player && npm run test -w @foundry/platform",
    "test:platform": "npm run test -w @foundry/platform",
    "test:e2e": "npm run test:e2e -w @foundry/platform",
    "test:e2e:single-host": "npm run test:e2e:single-host -w @foundry/platform",
    "test:smoke": "npm run test:smoke -w @foundry/platform",
    "release:single-host": "node apps/platform/scripts/create-single-host-release.mjs",
    "rehearse:single-host-release": "node apps/platform/scripts/rehearse-prebuilt-deployment.mjs",
    "test:staging": "npm run test:staging -w @foundry/platform",
    "verify:artifact": "npm run verify:artifact -w @foundry/platform",
    "verify:firebase-config": "npm run verify:firebase-config -w @foundry/platform",
    "verify:staging:firebase": "npm run verify:staging:firebase -w @foundry/platform",
    "verify:staging:r2": "npm run verify:staging:r2 -w @foundry/platform",
    "db:backup": "npm run db:backup -w @foundry/platform --",
    "db:restore": "npm run db:restore -w @foundry/platform --",
    "db:rehearse": "npm run db:rehearse -w @foundry/platform --",
    "single-host:backup": "npm run single-host:backup -w @foundry/platform --",
    "single-host:restore": "npm run single-host:restore -w @foundry/platform --",
    "single-host:rehearse": "npm run single-host:rehearse -w @foundry/platform --",
    "single-host:user": "npm run single-host:user -w @foundry/platform --",
    "single-host:doctor": "npm run single-host:doctor -w @foundry/platform --",
    "admin:provision": "npm run admin:provision -w @foundry/platform --",
    "storage:check": "npm run storage:check -w @foundry/platform",
    "fixture:streaming": "npm run fixture:streaming -w @foundry/platform",
    "verify:imports": "node scripts/verify-imports.mjs .",
    "verify": "npm run verify:imports && npm run verify:firebase-config",
    "check": "npm run verify && npm run lint -w @foundry/platform && npm test && npm run build && npm run verify:artifact"
  },
  "engines": {
    "node": ">=22"
  }
}
