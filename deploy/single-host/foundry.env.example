# Installed as /etc/foundry/foundry.env (root:foundry 0640).
# Generate both secret values independently; never commit the populated file.
NODE_ENV=production
FOUNDRY_DEPLOYMENT_MODE=single-host
# Default remains local-disk. Enable R2 only after the owner acceptance runbook.
FOUNDRY_STORAGE_PROVIDER=local-disk
PLATFORM_PUBLIC_BASE_URL=https://foundry.example.com
HOST=127.0.0.1
PORT=3000
TRUST_PROXY_HOPS=1
ENABLE_HSTS=false
CORS_ALLOWED_ORIGINS=

FOUNDRY_DATA_DIR=/var/lib/foundry
PLATFORM_DB_PATH=/var/lib/foundry/platform.db
LOCAL_AUTH_SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
LOCAL_AUTH_SESSION_TTL_SECONDS=604800
# Optional server-only Google login (local username/password stays available).
# Configure proxy log redaction first; see apps/platform/docs/GOOGLE_AUTH_RUNBOOK.md.
# Callback: PLATFORM_PUBLIC_BASE_URL + /api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LOCAL_STORAGE_SIGNING_SECRET=GENERATE_A_DIFFERENT_32_BYTE_SECRET
LOCAL_STORAGE_UPLOAD_URL_TTL_SECONDS=900

# Optional private R2 objects; SQLite/auth/jobs stay local. Never add VITE_ secrets.
# See apps/platform/docs/SINGLE_HOST_R2_ACCEPTANCE.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_OBJECT_PREFIX=
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=120
R2_DIRECT_DOWNLOADS=false

JOB_MODE=async
JOB_WORKER_ID=foundry-single-host-1
JOB_LEASE_MS=60000
MAX_JOB_ATTEMPTS=3
MAX_PUBLISH_ATTEMPTS=3
UPLOAD_CLEANUP_INTERVAL_MS=900000
UPLOAD_SESSION_EXPIRATION_MS=86400000
COMPLETED_UPLOAD_RETENTION_MS=604800000
SHUTDOWN_GRACE_MS=30000

E2E_MODE=false
SINGLE_HOST_TEST_MODE=false
LOCAL_DEV_MODE=false
AUTH_DEV_BYPASS=false
ALLOW_UNREADY_STARTUP=false
LOG_LEVEL=info

PLATFORM_MAX_STORAGE_BYTES_PER_USER=1073741824
PLATFORM_MAX_ACTIVE_UPLOADS_PER_USER=10
PLATFORM_MAX_GAME_VERSIONS_PER_USER=100
PLATFORM_MAX_PACKAGE_SIZE_BYTES=52428800
PLATFORM_MAX_FILES_PER_PACKAGE=1000
PLATFORM_MAX_EXTRACTED_FILES_PER_PACKAGE=1000
PLATFORM_MAX_TOTAL_EXTRACTED_SIZE_BYTES=104857600
PLATFORM_MAX_FILE_SIZE_BYTES=20971520

# Doctor fails if the persistent filesystem has less free space than this.
FOUNDRY_MIN_FREE_BYTES=1073741824
